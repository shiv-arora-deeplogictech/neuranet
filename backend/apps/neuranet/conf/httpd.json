{
    "timeout": 120000,
    "enableGZIPEncoding": true,
    "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "POST, GET",
        "Access-Control-Allow-Headers": "*",
        "Access-Control-Expose-Headers": "*",
        "Access-Control-Max-Age": 86400
    },
    "host": "{{{hostname}}}",
    "ports": [
        9090,
        9091
    ],
    "ssl": true,
    "sslKeyFile": "/home/deep/Neuranet-Install/Neuranet-testing/etc/dnsip_privkey.pem",
    "sslCertFile": "/home/deep/Neuranet-Install/Neuranet-testing/etc/dnsip_fullchain.pem",
    "ipblacklistRefresh": 5000,
    "ipwhitelistRefresh": 5000,
    "virtualhosts": [
        "{{{hostname}}}:9090"
    ]
}